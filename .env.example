APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://appuser:apppassword@postgres:5432/appdb
JWT_SECRET=smarthealth-local-demo-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=app-workflow
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CONSUMER_GROUP=app-analytics
KAFKA_TOPIC_PREFIX=app
EMBEDDING_PROVIDER=huggingface
EMBEDDING_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.65
BILLING_FORCE_FAILURE=false
