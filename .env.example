APP_ENV=local
BUILD_REVISION=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://appuser:apppassword@postgres:5432/appdb
JWT_SECRET=smarthealth-local-demo-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=app-workflow
TEMPORAL_WORKFLOW_TIMEOUT_MINUTES=30
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CONSUMER_GROUP=app-analytics
KAFKA_TOPIC_PREFIX=app
EMBEDDING_PROVIDER=huggingface
EMBEDDING_API_KEY=
EMBEDDING_MODEL=microsoft/harrier-oss-v1-0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.50
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=60
USE_FAKE_LLM=false
AI_RATE_LIMIT_PER_MINUTE=30
AI_CACHE_TTL_SECONDS=300
AI_CONVERSATION_KEY=
BOOKING_DEMO_PAUSE_SECONDS=0
ASYNC_BOOKING_ENABLED=false
BOOKING_WORKFLOW_TIMEOUT_MINUTES=30
BOOKING_FORCE_FAILURE=false
BILLING_FORCE_FAILURE=false
